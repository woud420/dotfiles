{
  "suggest.maxCompleteItemCount": 20,
  "suggest.noselect": false,
  "suggest.preferCompleteThanJumpPlaceholder": true,
  "suggest.acceptSuggestionOnCommitCharacter": true,

  "diagnostic.errorSign": "✘",
  "diagnostic.warningSign": "⚠",
  "diagnostic.infoSign": "ℹ",
  "diagnostic.hintSign": "➤",
  "diagnostic.virtualText": true,
  "diagnostic.checkCurrentLine": true,

  "signature.enable": true,
  "signature.target": "float",

  "hover.target": "float",

  "colors.enable": true,

  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "python.formatting.provider": "black",

  "typescript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": true,
  "javascript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": true,

  "[python]": { "coc.preferences.formatOnSave": true },
  "[javascript]": { "coc.preferences.formatOnSave": true },
  "[typescript]": { "coc.preferences.formatOnSave": true },
  "[json]": { "coc.preferences.formatOnSave": true },
  "[jsonc]": { "coc.preferences.formatOnSave": true },
  "[yaml]": { "coc.preferences.formatOnSave": true },
  "[rust]": { "coc.preferences.formatOnSave": true }
}
