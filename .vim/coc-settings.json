{
  "suggest.maxCompleteItemCount": 20,
  "suggest.noselect": false,
  "suggest.preferCompleteThanJumpPlaceholder": true,
  "suggest.acceptSuggestionOnCommitCharacter": true,
  "suggest.formatItems": ["kind", "abbr", "menu"],
  "suggest.snippetIndicator": "",
  "suggest.labelMaxLength": 40,
  "suggest.pumFloatConfig": { "border": true, "rounded": true, "winblend": 10 },
  "suggest.floatConfig": { "border": true, "rounded": true, "maxWidth": 80, "winblend": 10 },
  "suggest.completionItemKindLabels": {
    "text": " 󰉱 ",
    "method": " 󰆧 ",
    "function": " 󰊕 ",
    "constructor": "  ",
    "field": " 󰜢 ",
    "variable": " 󰀫 ",
    "class": " 󰠱 ",
    "interface": "  ",
    "module": "  ",
    "property": " 󰜢 ",
    "unit": " 󰑭 ",
    "value": " 󰎠 ",
    "enum": "  ",
    "keyword": " 󰌋 ",
    "snippet": "  ",
    "color": " 󰏘 ",
    "file": " 󰈙 ",
    "reference": " 󰈇 ",
    "folder": " 󰉋 ",
    "enumMember": "  ",
    "constant": " 󰏿 ",
    "struct": " 󰙅 ",
    "event": "  ",
    "operator": " 󰆕 ",
    "typeParameter": "  ",
    "default": "  "
  },

  "diagnostic.errorSign": "✘",
  "diagnostic.warningSign": "⚠",
  "diagnostic.infoSign": "ℹ",
  "diagnostic.hintSign": "➤",
  "diagnostic.virtualText": true,
  "diagnostic.checkCurrentLine": true,
  "diagnostic.virtualTextPrefix": "  ● ",
  "diagnostic.floatConfig": { "border": true, "rounded": true, "maxWidth": 80, "winblend": 10 },

  "signature.enable": true,
  "signature.target": "float",
  "signature.floatConfig": { "border": true, "rounded": true, "winblend": 10 },

  "hover.target": "float",
  "hover.floatConfig": { "border": true, "rounded": true, "maxWidth": 80, "winblend": 10 },

  "colors.enable": true,

  "python.linting.enabled": false,
  "python.formatting.provider": "none",
  "languageserver": {
    "ruff": { "command": "ruff", "args": ["server"], "filetypes": ["python"] }
  },

  "typescript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": true,
  "javascript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": true,

  "[python]": { "coc.preferences.formatOnSave": true },
  "[javascript]": { "coc.preferences.formatOnSave": true },
  "[typescript]": { "coc.preferences.formatOnSave": true },
  "[json]": { "coc.preferences.formatOnSave": true },
  "[jsonc]": { "coc.preferences.formatOnSave": true },
  "[yaml]": { "coc.preferences.formatOnSave": true },
  "[rust]": { "coc.preferences.formatOnSave": true }
}
